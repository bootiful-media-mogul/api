#@specifiedBy(url: "https://scalars.graphql.org/andimarek/date-time.html")

scalar DateTime
scalar JSON



type Setting {
    name: String
    value: String
    valid: Boolean
    required: Boolean
    # SECRET, TEXT or BOOLEAN: how the settings page should show it
    type: String
    # what an unset value means, if anything
    defaultValue: String
}

type Composition  {
    #    mogulId: Int
    id: Int
    field: String
    attachments: [Attachment]
}

type Transcript {
    id: Int
    mogulId: Int
    transcript: String
}

type Attachment {
    id: Int
    caption: String
    managedFile: ManagedFile
    markdown: String
}

type Publication {
    mogulId: Int
    id: Int
    plugin: String
    url: String
    created: DateTime
    published: DateTime
    # when it's due to be published, if the user picked a time. null means as soon as possible.
    scheduled: DateTime
    # pending, published, unpublished (or draft, for the oldest rows)
    state : String
    outcomes: [PublicationOutcome]
}

type PublicationOutcome  {

    id: Int
    created: DateTime
    success: Boolean
    url:String
    key:String
    serverErrorMessage:String
    # an already-abbreviated, one-line rendition of what actually went out -- the text
    # of the tweet, say. null for the outcomes with nothing worth previewing.
    preview:String

}

type SettingsPage {
    valid    : Boolean
    category : String
    settings : [Setting]
}

# a diagnostic: which wall clock the two writers of a `timestamp without time zone`
# actually use. they are not necessarily the same.
type ServerTime {
    instant: String
    javaTimeZone: String
    javaOffset: String
    javaLocalTime: String
    databaseTimeZone: String
    databaseLocalTime: String
}

type Mogul {
    id: Int
    name : String
    givenName : String
    familyName : String
    email : String
    # IANA zone id; null until the mogul has told us where they are
    timeZone : String
}

# a single day in the life of a Mogul, and the thing that actually gets published
# when you publish "about" a mogul. at most one per mogul per date.
type MogulStatus {
    id: Int
    mogulId: Int
    date: String
    created: DateTime
    # batch-loaded: N days of publications cost one round of SQL, not N
    publications: [Publication]
}

type ManagedFile {
    id: Int
    bucket: String
    folder: String
    filename: String
    contentType: String
    size: Float
    written : Boolean
    visible : Boolean
    url : String
    visibleUrl: String
    downloadableUrl: String
}

type KeptRange {
    start: Int
    end: Int
}

type SegmentFilters {
    fillers: Boolean
    stutters: Boolean
    silences: Boolean
    silenceLongerThan: Int
    silenceLeave: Int
}

input SegmentFiltersInput {
    fillers: Boolean!
    stutters: Boolean!
    silences: Boolean!
    silenceLongerThan: Int!
    silenceLeave: Int!
}

input KeptRangeInput {
    start: Int!
    end: Int!
}

type Episode {
    id : Int
    titleComposition: Composition
    descriptionComposition: Composition
    # availablePlugins :[String]
    title: String
    description: String
    # valid: Boolean
    graphic: ManagedFile
    podcastId: Int
    producedAudio: ManagedFile
    complete: Boolean
    created: DateTime
    segments : [Segment]
    duration: Float
}

type Segment {
    #    transcribable : Boolean
    id : Int
    name : String
    audio: ManagedFile
    producedAudio : ManagedFile
    # the waveform of audio, drawn by the processors. null for older segments until one is requested
    waveform: ManagedFile
    # the ranges of audio to keep by hand, in milliseconds, in the order they play. null if unedited
    edits: [KeptRange]
    # cleanvoice's cleaned copy of audio, once there is one for the audio as it is now
    cleanedAudio: ManagedFile
    cleaned: Boolean
    # being cleaned and re-rendered right now
    cleaning: Boolean
    # why the last cleaning failed, if it did
    cleaningError: String
    # whether clicking can start a cleaning: there's audio, a cleanvoice key, and none running
    cleanable: Boolean
    # json, in milliseconds: {"cleanvoice": [{start, end, kind}], "silences": [{start, end}]}
    detections: String
    # the automatic cuts in effect: the mogul's choice, or the default from their settings
    filters: SegmentFilters
    # ids of detections put back despite the filters, like "FILLER_SOUND@4380"
    restored: [String]
    order : Int
    crossFadeDuration : Int
    transcript: Transcript
    duration: Float
}

type Podcast {
    id: Int
    title: String
    episodes : [Episode]
    created: DateTime
}

type NotificationEvent {
    mogulId: Int
    category: String
    key: String
    when : DateTime
    context : String
    modal : Boolean
    visible : Boolean
}

type AyrsharePublicationComposition {
    id: Int
    composition: Composition
    publication: Publication
    platform: String
}


type SearchableResult {
    aggregateId: Int
    searchableId: Int
    title: String
    type: String
    context : String
    created: DateTime
}

type Note {
    id: Int
    note: String
    created: DateTime
    done: DateTime
    type: String
}

type EntityContext {
    resolvedType :String
    context :String
}

type NotificationContext  {
    ablyChannel : String
    ablyTokenRequest : TokenRequest
}

type TokenRequest {
    keyName: String
    nonce: String
    mac: String
    ttl: String
    capability: String
    timestamp: String
}

type Blog {
    id: Int
    title: String
    description: String
    rssUrl: String
    created: DateTime
}

type Post {
    id :Int
    created: DateTime
    title :String
    content:String
    summary:String
    rssSlug:String
    complete :Boolean
    visible :Boolean
    descriptionComposition: Composition
}

# wordpress
type WordPressStatus {
    displayName: String
    connected: Boolean
    id: Int
}

type Job {
    name : String
    requiredContextAttributes : [String]
}

type Mutation {

    # blog
    createBlog (title:String, description:String): Blog

    updateBlog(blogId:Int, title:String, description:String, rssUrl:String ): Boolean

    deleteBlog (blogId:Int): Boolean

    createPost(blogId:Int, title:String, content:String, summary:String, rssSlug:String): Post

    updatePost(postId:Int, title:String, description:String, summary:String, rssSlug:String, created: DateTime): Boolean

    setBlogPostVisibility(postId:Int, visible:Boolean): Boolean

    deletePost(postId:Int): Boolean

    summarize(content:String): String

    # notes
    createNote(type:String, id:Int, note:String): Boolean
    deleteNote(id:Int) : Boolean
    updateNote(id:Int, note:String): Boolean
    setNoteDone(id:Int, done:Boolean): Boolean


    # jobs
    launchJob(jobName:String, contextAsJson: String ) : Boolean
    createJobManagedFile(jobName:String) : ManagedFile

    # transcriptions
    writeTranscript(transcriptId:Int, transcript:String) : Boolean
    refreshTranscript(transcriptId :Int) : Boolean

    # mogul
    setMogulTimeZone( timeZone: String ) : Boolean

    # publicationService
    unpublish( publicationId: Int ) : Boolean
    # every publication runs on jobrunr, now or at 'scheduled' if it's given. this returns the
    # (pending) publication's id before anything has been published; the outcome arrives as
    # notifications.
    publish( publishableId: Int, publishableType: String, contextJson: String, plugin: String, scheduled: DateTime ) : Int

    # compositions
    createCompositionAttachment( compositionId: Int ) : Attachment
    deleteCompositionAttachment( compositionAttachmentId: Int ) : Boolean

    # podcasts
    createPodcast(title:String): Podcast
    deletePodcast(podcastId:Int): Boolean
    updatePodcast(podcastId:Int, title:String ): Boolean

    # podcast episodes
    createPodcastEpisodeDraft(
        podcastId:Int ,
        title:String,
        description:String): Episode
    updatePodcastEpisode( podcastEpisodeId: Int, title: String, description: String, created: DateTime): Boolean
    deletePodcastEpisode(podcastEpisodeId: Int): Boolean

    # podcast episode segments
    deletePodcastEpisodeSegment(podcastEpisodeSegmentId: Int): Boolean
    createPodcastEpisodeSegment( podcastEpisodeId:  Int ): Int
    # keeps only these ranges of the segment's audio and re-renders it. null keeps all of it
    editPodcastEpisodeSegment(podcastEpisodeSegmentId: Int, kept: [KeptRangeInput!], filters: SegmentFiltersInput, restored: [String!]): Boolean
    # cleans the segment's audio with the mogul's cleanvoice account
    cleanPodcastEpisodeSegment(podcastEpisodeSegmentId: Int): Boolean
    requestPodcastEpisodeSegmentWaveform(podcastEpisodeSegmentId: Int): Boolean
    #    setPodcastEpisodeSegmentTranscript(podcastEpisodeSegmentId: Int , transcript: String) : Boolean
    #    transcribePodcastEpisodeSegment(podcastEpisodeSegmentId: Int ) : Boolean
    movePodcastEpisodeSegmentUp(podcastEpisodeId: Int, podcastEpisodeSegmentId: Int  ): Boolean
    movePodcastEpisodeSegmentDown(podcastEpisodeId: Int, podcastEpisodeSegmentId: Int  ): Boolean

    # managed files
    setManagedFileVisibility(managedFileId: Int , visible: Boolean): Boolean

    # settings
    updateSetting(category:String, name:String, value:String): Boolean
}

type Query {

    # wordpress
    wordPressStatus : WordPressStatus

    # blogs
    blogById(blogId: Int) : Blog
    blogs: [Blog]
    blogPostsByBlog (blogId: Int) : [Post]
    postById(postId: Int) : Post



    # context for navigation
    entityContext(type: String, id: Int): EntityContext

    # jobs
    jobs : [Job]

    # search
    search(query: String, metadata: JSON): [SearchableResult]

    ayrsharePublicationCompositions: [AyrsharePublicationComposition]

    # notes
    notesForNotable(type:String, id:Int, includeDone:Boolean): [Note]

    # publicationService
    publicationsForPublishable( type : String, id: Int ) : [Publication]
    canPublish (publishableId: Int , publishableType: String , contextJson: String , plugin: String) : Boolean

    # compositions
    compositionById ( compositionId:Int) : Composition

    # misc 
    renderedMarkdown( markdown : String) : String

    # notifications
    notificationContext : NotificationContext

    # settings
    settings: [SettingsPage]

    # diagnostics
    serverTime: ServerTime

    # mogul
    me: Mogul
    mogulStatusToday: MogulStatus
    mogulStatuses(limit: Int): [MogulStatus]

    # ai
    aiChat(prompt:String): String

    # podcasts
    podcastById(podcastId: Int): Podcast
    podcasts: [Podcast]
    podcastEpisodeById(podcastEpisodeId:Int):Episode
    podcastEpisodeSegmentById(podcastEpisodeSegmentId:Int):Segment
    podcastEpisodesByPodcast(podcastId:Int):[Episode]

    # managedFiles
    managedFileById( managedFileId: Int) : ManagedFile

    # ayrshare
    ayrsharePlatforms: [String]
}
